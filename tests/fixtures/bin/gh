#!/bin/sh
# tests/fixtures/bin/gh — deterministic gh CLI stub for E2E tests
#
# Returns canned JSON from tests/fixtures/gh/ for supported commands.
# Set GITFLOW_GH_LOG to a file path to record all invocations.
# Set GITFLOW_GH_FAIL=<subcommand> to force that subcommand to fail.
# Set GITFLOW_GH_DELAY=<seconds> to hold every answer open, so a test can slip
# a `cd` into the round trip.
#
# This stub REJECTS malformed invocations rather than blessing them. A canned
# answer to any method is how `gh api <list> --paginate -f state=all` shipped
# green and then 422'd against real GitHub (#429): `gh api` with -f/-F defaults
# to POST, so that argv hit create-a-milestone. See validate_api below.
set -eu

if [ -n "${GITFLOW_GH_LOG:-}" ]; then
  printf '%s\n' "$*" >> "$GITFLOW_GH_LOG"
fi

if [ -n "${GITFLOW_GH_DELAY:-}" ]; then
  sleep "$GITFLOW_GH_DELAY"
fi

needs_stdin=false
prev_arg=""
for arg in "$@"; do
  if [ "$prev_arg" = "--input" ] && [ "$arg" = "-" ]; then
    needs_stdin=true
    break
  fi
  prev_arg="$arg"
done

if [ "$needs_stdin" = true ]; then
  stdin_payload="$(cat)"
  if [ -n "${GITFLOW_GH_LOG:-}" ]; then
    printf 'stdin %s\n' "$stdin_payload" >> "$GITFLOW_GH_LOG"
  fi
fi

# Resolve fixture directory relative to this script
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
FIXTURE_DIR="$SCRIPT_DIR/../gh"

# Allow forcing failure for any subcommand
fail_cmd="${GITFLOW_GH_FAIL:-}"

# ── argv validation (mirrors what real gh/GitHub reject) ───────────────
# Endpoints gitflow only ever reads. GitHub routes a non-GET here to a
# different operation entirely (POST /milestones is create-a-milestone).
is_read_only_endpoint() {
  case "$1" in
    */milestones|*/milestones\?*) return 0 ;;
    */assignees|*/assignees\?*)   return 0 ;;
    */pulls/*/files|*/pulls/*/commits) return 0 ;;
    user|user\?*) return 0 ;;
    *) return 1 ;;
  esac
}

# The method real `gh api` would use: explicit -X/--method wins, otherwise
# any -f/-F/--field/--raw-field/--input makes it POST, else GET.
api_effective_method() {
  method=""
  has_body=false
  expect_method=false
  for a in "$@"; do
    if [ "$expect_method" = true ]; then
      method="$a"
      expect_method=false
      continue
    fi
    case "$a" in
      -X|--method) expect_method=true ;;
      -f|-F|--field|--raw-field|--input) has_body=true ;;
    esac
  done
  if [ -n "$method" ]; then
    printf '%s' "$method" | tr '[:lower:]' '[:upper:]'
  elif [ "$has_body" = true ]; then
    printf 'POST'
  else
    printf 'GET'
  fi
}

api_has_paginate() {
  for a in "$@"; do
    [ "$a" = "--paginate" ] && return 0
  done
  return 1
}

# Refuse the two shapes GitHub refuses, so a wrong method cannot pass here
# and fail only in a user's editor.
validate_api() {
  endpoint="$1"
  shift
  method="$(api_effective_method "$@")"
  if [ "$method" != "GET" ] && api_has_paginate "$@"; then
    echo "gh stub: --paginate on a $method request to '$endpoint'" \
      "— pagination is GET-only; pass -X GET" >&2
    exit 1
  fi
  if [ "$method" != "GET" ] && is_read_only_endpoint "$endpoint"; then
    echo "gh stub: $method to read-only endpoint '$endpoint'" \
      "— gh api defaults to POST when -f/-F is present; pass -X GET" >&2
    exit 1
  fi
}

# gh validates --reason itself and rejects the API's own `not_planned`
# spelling; its enum is {completed|not planned|duplicate}.
validate_close_reason() {
  expect_reason=false
  for a in "$@"; do
    if [ "$expect_reason" = true ]; then
      case "$a" in
        completed|"not planned"|duplicate) ;;
        *)
          echo "invalid argument \"$a\" for \"-r, --reason\" flag:" \
            "valid values are {completed|not planned|duplicate}" >&2
          exit 1
          ;;
      esac
      expect_reason=false
      continue
    fi
    case "$a" in
      -r|--reason) expect_reason=true ;;
    esac
  done
}

# ── Top-level flags ────────────────────────────────────────────────────
if [ "$#" -ge 1 ] && [ "$1" = "--version" ]; then
  echo "gh version 2.55.0 (2026-01-15)"
  exit 0
fi

subcmd="${1:-}"
shift 2>/dev/null || true
sub2="${1:-}"
shift 2>/dev/null || true

case "$subcmd" in

  # ── auth ──────────────────────────────────────────────────────────────
  auth)
    case "$sub2" in
      status)
        if [ "$fail_cmd" = "auth" ]; then
          echo "You are not logged into any GitHub hosts." >&2
          exit 1
        fi
        echo "Logged in to github.com as e2e-test-user"
        ;;
      *)
        echo "gh stub: unknown auth subcommand '$sub2'" >&2
        exit 1
        ;;
    esac
    ;;

  # ── pr ────────────────────────────────────────────────────────────────
  pr)
    if [ "$fail_cmd" = "pr" ]; then
      echo "gh pr failed" >&2
      exit 1
    fi
    case "$sub2" in
      view)
        # Check for failure variant
        pr_num="${1:-}"
        if [ -f "$FIXTURE_DIR/pr_view_fail.json" ] && \
           [ "$pr_num" = "999" ]; then
          cat "$FIXTURE_DIR/pr_view_fail.json" >&2
          exit 1
        fi
        cat "$FIXTURE_DIR/pr_view.json"
        ;;
      create)
        if [ "$fail_cmd" = "pr_create" ]; then
          echo "gh pr create failed: unable to create" >&2
          exit 1
        fi
        cat "$FIXTURE_DIR/pr_create.json"
        ;;
      list)
        cat "$FIXTURE_DIR/pr_list.json"
        ;;
      comment)
        echo "pr comment ok"
        ;;
      review)
        if [ "$fail_cmd" = "pr_review" ]; then
          echo "gh pr review failed" >&2
          exit 1
        fi
        echo "pr review ok"
        ;;
      diff)
        if [ -f "$FIXTURE_DIR/pr_diff.patch" ]; then
          cat "$FIXTURE_DIR/pr_diff.patch"
        else
          echo ""
        fi
        ;;
      merge)
        echo "pr merge ok"
        ;;
      checkout)
        echo "pr checkout ok"
        ;;
      close)
        echo "pr close ok"
        ;;
      reopen)
        echo "pr reopen ok"
        ;;
      ready)
        echo "pr ready ok"
        ;;
      edit)
        echo "pr edit ok"
        ;;
      *)
        echo "gh stub: unknown pr subcommand '$sub2'" >&2
        exit 1
        ;;
    esac
    ;;

  # ── issue ─────────────────────────────────────────────────────────────
  issue)
    if [ "$fail_cmd" = "issue" ]; then
      echo "gh issue failed" >&2
      exit 1
    fi
    case "$sub2" in
      list)
        cat "$FIXTURE_DIR/issue_list.json"
        ;;
      view)
        issue_num="${1:-}"
        if [ -f "$FIXTURE_DIR/issue_view_fail.json" ] && \
           [ "$issue_num" = "999" ]; then
          cat "$FIXTURE_DIR/issue_view_fail.json" >&2
          exit 1
        fi
        cat "$FIXTURE_DIR/issue_view.json"
        ;;
      create)
        echo "https://github.com/devGunnin/Gitflow/issues/10"
        ;;
      comment)
        echo "issue comment ok"
        ;;
      close)
        validate_close_reason "$@"
        echo "issue close ok"
        ;;
      reopen)
        echo "issue reopen ok"
        ;;
      edit)
        echo "issue edit ok"
        ;;
      *)
        echo "gh stub: unknown issue subcommand '$sub2'" >&2
        exit 1
        ;;
    esac
    ;;

  # ── label ─────────────────────────────────────────────────────────────
  label)
    if [ "$fail_cmd" = "label" ]; then
      echo "gh label failed" >&2
      exit 1
    fi
    case "$sub2" in
      list)
        cat "$FIXTURE_DIR/label_list.json"
        ;;
      create)
        echo "label create ok"
        ;;
      delete)
        echo "label delete ok"
        ;;
      *)
        echo "gh stub: unknown label subcommand '$sub2'" >&2
        exit 1
        ;;
    esac
    ;;

  # ── api ───────────────────────────────────────────────────────────────
  api)
    if [ "$fail_cmd" = "api" ]; then
      echo "gh api failed" >&2
      exit 1
    fi
    # Route api calls based on endpoint path
    endpoint="$sub2"
    validate_api "$endpoint" "$@"
    case "$endpoint" in
      user|user\?*)
        # `-q .login` is the only projection any call site asks for.
        case " $* " in
          *" .login "*) echo "e2e-test-user" ;;
          *) echo '{"login": "e2e-test-user"}' ;;
        esac
        ;;
      *pulls/*/files)
        if [ -f "$FIXTURE_DIR/pr_files.json" ]; then
          cat "$FIXTURE_DIR/pr_files.json"
        else
          echo '[]'
        fi
        ;;
      *pulls/*/comments)
        if [ -f "$FIXTURE_DIR/pr_review_comments.json" ]; then
          cat "$FIXTURE_DIR/pr_review_comments.json"
        else
          echo '[]'
        fi
        ;;
      *pulls/*/reviews)
        # POST review submission or GET reviews list
        echo '{"id": 5001, "state": "APPROVED"}'
        ;;
      *pulls/*/comments/*/replies)
        echo '{"id": 6001, "body": "reply ok"}'
        ;;
      *milestones*)
        if [ -f "$FIXTURE_DIR/milestones.json" ]; then
          cat "$FIXTURE_DIR/milestones.json"
        else
          echo '[]'
        fi
        ;;
      *issues/comments/*)
        echo '{"id": 7001, "body": "issue comment ok"}'
        ;;
      *)
        echo '[]'
        ;;
    esac
    ;;

  # ── run ───────────────────────────────────────────────────────────────
  run)
    if [ "$fail_cmd" = "run" ]; then
      echo "gh run failed" >&2
      exit 1
    fi
    case "$sub2" in
      list)
        cat "$FIXTURE_DIR/run_list.json"
        ;;
      view)
        case " $* " in
          *" --log-failed "*)
            if [ -f "$FIXTURE_DIR/run_view_log_failed.txt" ]; then
              cat "$FIXTURE_DIR/run_view_log_failed.txt"
            else
              echo ""
            fi
            ;;
          *" --job "*" --log "*)
            if [ -f "$FIXTURE_DIR/run_view_job_log.txt" ]; then
              cat "$FIXTURE_DIR/run_view_job_log.txt"
            else
              echo ""
            fi
            ;;
          *" --log "*)
            if [ -f "$FIXTURE_DIR/run_view_log.txt" ]; then
              cat "$FIXTURE_DIR/run_view_log.txt"
            else
              echo ""
            fi
            ;;
          *)
            cat "$FIXTURE_DIR/run_view.json"
            ;;
        esac
        ;;
      rerun)
        if [ "$fail_cmd" = "run_rerun" ]; then
          echo "gh run rerun failed" >&2
          exit 1
        fi
        case " $* " in
          *" --failed "*)
            echo "Requested rerun of failed jobs"
            ;;
          *" --job "*)
            echo "Requested rerun of job"
            ;;
          *)
            echo "Requested rerun"
            ;;
        esac
        ;;
      cancel)
        if [ "$fail_cmd" = "run_cancel" ]; then
          echo "gh run cancel failed" >&2
          exit 1
        fi
        echo "Requested cancellation"
        ;;
      *)
        echo "gh stub: unknown run subcommand '$sub2'" >&2
        exit 1
        ;;
    esac
    ;;

  # ── workflow ──────────────────────────────────────────────────────────
  workflow)
    if [ "$fail_cmd" = "workflow" ]; then
      echo "gh workflow failed" >&2
      exit 1
    fi
    case "$sub2" in
      list)
        cat "$FIXTURE_DIR/workflow_list.json"
        ;;
      run)
        if [ "$fail_cmd" = "workflow_run" ]; then
          echo "gh workflow run failed" >&2
          exit 1
        fi
        echo "Created workflow_dispatch event"
        ;;
      *)
        echo "gh stub: unknown workflow subcommand '$sub2'" >&2
        exit 1
        ;;
    esac
    ;;

  # ── repo ──────────────────────────────────────────────────────────────
  repo)
    if [ "$fail_cmd" = "repo" ]; then
      echo "gh repo failed" >&2
      exit 1
    fi
    case "$sub2" in
      view)
        case " $* " in
          *" .nameWithOwner "*) echo "devGunnin/gitflow" ;;
          *) echo '{"nameWithOwner": "devGunnin/gitflow"}' ;;
        esac
        ;;
      *)
        echo "gh stub: unknown repo subcommand '$sub2'" >&2
        exit 1
        ;;
    esac
    ;;

  # ── Unknown ───────────────────────────────────────────────────────────
  *)
    echo "gh stub: unknown command '$subcmd'" >&2
    exit 1
    ;;
esac

exit 0
